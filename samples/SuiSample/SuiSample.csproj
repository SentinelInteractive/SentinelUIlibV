<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SuiSample</AssemblyName>
    <RootNamespace>SuiSample</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Game.IsKeyDown takes System.Windows.Forms.Keys. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LSPDFR callout sample for SentinelUI. Build with: dotnet build, then deploy.ps1 -->
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Grand Theft Auto V</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="RagePluginHook" Version="1.124.0" ExcludeAssets="runtime" PrivateAssets="all" />

    <Reference Include="LSPD First Response">
      <HintPath>$(GameDir)\plugins\LSPD First Response.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SentinelUI managed API, as deployed in the game root. Copied next to the callout. -->
    <Reference Include="SentinelUI.API">
      <HintPath>$(GameDir)\SentinelUI.API.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
